# Vortex Autonomous Creator - Environment Configuration
# Copy this file to .env and fill in your values.

# OpenAI API key used by the "Vortex" persona for discovery evaluation and article generation.
# Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# OpenAI model to use. gpt-4o-mini is the default per spec.
OPENAI_MODEL=gpt-4o-mini

# Port the headless REST API listens on.
PORT=3000

# How often the autonomous loop runs, as a node-cron expression.
# Default: every 2 hours. Change to taste, but keep it >= every 2 hours
# to respect the 48-hour continuous-cycle minimum.
CRON_SCHEDULE=0 */2 * * *

# Number of hours the autonomous cycle is guaranteed to keep running
# after initialization. Minimum 48 per spec.
CYCLE_HOURS=48
